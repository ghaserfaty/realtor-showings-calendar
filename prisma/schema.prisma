generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

enum CalendarSyncStatus {
  PENDING
  SYNCED
  ERROR
}

enum CalendarProviderType {
  MOCK
  GOOGLE
}

model Realtor {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  displayName              String?
  googleSubject            String?                   @unique
  avatarUrl                String?
  adminApiKeyHash          String?                   @unique
  calendarProvider         CalendarProviderType      @default(MOCK)
  googleCalendarConnection GoogleCalendarConnection?
  sessions                 RealtorSession[]
  invitations              Invitation[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
}

model GoogleOAuthAttempt {
  id                    String   @id
  stateHash             String   @unique
  nonceHash             String
  encryptedCodeVerifier String
  expiresAt             DateTime
  createdAt             DateTime @default(now())

  @@index([expiresAt])
}

model RealtorSession {
  id         String   @id @default(cuid())
  realtorId  String
  realtor    Realtor  @relation(fields: [realtorId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([realtorId, expiresAt])
}

model GoogleCalendarConnection {
  realtorId             String   @id
  realtor               Realtor  @relation(fields: [realtorId], references: [id], onDelete: Cascade)
  encryptedRefreshToken String
  encryptedCalendarId   String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Invitation {
  id             String         @id @default(cuid())
  tokenHash      String         @unique
  invitedEmail   String
  invitedName    String?
  invitedPhone   String?
  realtorId      String
  realtor        Realtor        @relation(fields: [realtorId], references: [id], onDelete: Restrict)
  expiresAt      DateTime
  revokedAt      DateTime?
  maxSubmissions Int?
  createdAt      DateTime       @default(now())
  lastAccessedAt DateTime?
  registrations  Registration[]

  @@index([expiresAt])
  @@index([realtorId])
}

model Registration {
  id                 String             @id @default(cuid())
  invitationId       String
  invitation         Invitation         @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  calendarEventId    String
  fullName           String
  email              String
  phone              String
  notes              String?
  status             RegistrationStatus @default(CONFIRMED)
  registeredAt       DateTime           @default(now())
  cancelledAt        DateTime?
  calendarSyncStatus CalendarSyncStatus @default(PENDING)
  calendarSyncError  String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([invitationId, calendarEventId])
  @@index([calendarEventId, status])
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  invitationId String?
  actorType    String
  actorId      String?
  metadata     Json?
  ipHash       String?
  createdAt    DateTime @default(now())

  @@index([invitationId, createdAt])
  @@index([action, createdAt])
}
