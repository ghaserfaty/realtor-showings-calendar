# Database
DATABASE_URL=postgresql://showings:showings@localhost:5434/showings?schema=public

# Public URL and internal API authentication
APP_URL=http://localhost:3000
ADMIN_API_KEY=replace-with-at-least-24-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-an-independent-32-character-secret
REALTOR_EMAIL=realtor@example.com
REALTOR_DISPLAY_NAME=Your Realtor

# Invitation verification and email
REQUIRE_INVITATION_EMAIL_VERIFICATION=false
EMAIL_PROVIDER=console
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_API_KEY=
SESSION_COOKIE_SECURE=false

# Calendar provider: mock or google
CALENDAR_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
SHOWING_FILTER_MODE=dedicated_calendar
SHOWING_EVENT_TYPE=property_showing
SHOWING_TITLE_PREFIX=[SHOWING]
SHOWING_OPEN_TITLE_PREFIX=[ABIERTA]
SHOWING_CLOSED_TITLE_PREFIX=[CERRADA]
SHOWING_PUBLIC_BLOCK_START=PUBLIC_SHOWING
SHOWING_PUBLIC_BLOCK_END=END_PUBLIC_SHOWING

# Optional behavior
ALLOW_REGISTRATION_CANCELLATION=true
EXPOSE_GOOGLE_MEET_LINKS=false
ADD_REGISTRANTS_AS_ATTENDEES=false
LOG_LEVEL=info
